# Slack — create an app from slack-app-manifest.yaml, enable Socket Mode
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Anthropic — get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model
# CANTEEN_MODEL=claude-opus-5

# Production only: your deployed domain's real callback (must match what's
# registered with Swiggy). Leave unset locally — defaults to the localhost
# paste-flow redirect.
# CANTEEN_REDIRECT_URI=https://swiggy-canteen.onrender.com/callback

# Local state
CANTEEN_DB=canteen.db
